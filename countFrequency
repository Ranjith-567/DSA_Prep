function countFrequency(arr) {
    const frequency = new Map();
    for (let num of arr) {
        frequency.set(num, (frequency.get(num) || 0) + 1);
    }
    return Object.fromEntries(frequency);
}
console.log(countFrequency([1, 2, 3, 2, 1])); // Output: {1: 2, 2: 2, 3: 1}

//fromEntries is a method that transforms a list of key-value pairs into an object. In this case, we use it to convert the Map of frequencies into a plain JavaScript object for easier readability and usage. 